local Event = game:GetService("ReplicatedStorage").Remotes.CrystalDropRequest

local runes = {
    "Haste Rune",
    "Storm Rune",
    "Weight Rune",
    "Fortune Rune",
    "Detonation Rune",
    "Preservation Rune",
    "Warmth Rune",
    "Excavator Rune",
    "Colossus Rune"
}

local function startRune()

    if runeRunning then
        return
    end

    runeRunning = true

    task.spawn(function()

        while runeRunning do

            for _, rune in ipairs(runes) do
                Event:FireServer(rune)
            end

            task.wait()

        end

    end)

end

