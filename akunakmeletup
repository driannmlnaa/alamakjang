local function toggleUI()

    if screenGui then

        screenGui.Enabled =
            not screenGui.Enabled

    end

end

--------------------------------------------------
-- F TOGGLE
--------------------------------------------------

UserInputService.InputBegan:Connect(
    function(
        input,
        gameProcessed
    )

        if not gameProcessed
            and input.KeyCode ==
                Enum.KeyCode.F then

            toggleUI()

        end

    end
)

